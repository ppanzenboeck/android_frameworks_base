<resources>

    <!-- Define device configs on boot -->
    <java-symbol type="array" name="global_device_configs_override" />
    <java-symbol type="array" name="device_configs_override" />

    <!-- Light / Regular style fonts -->
    <java-symbol type="string" name="config_lightFontFamily" />
    <java-symbol type="string" name="config_regularFontFamily" />

    <!-- Cycle through ringer modes -->
    <java-symbol type="string" name="volume_dialog_ringer_guidance_normal" />

    <!-- App error dialog -->
    <java-symbol type="id" name="aerr_copy" />
    <java-symbol type="string" name="url_copy_success" />
    <java-symbol type="string" name="url_copy_failed" />

    <!-- Whether to cancel fingerprint operation if not idle -->
    <java-symbol type="bool" name="config_fpCancelIfNotIdle" />

    <!-- Lock gesture -->
    <java-symbol type="string" name="gesture_locked_warning" />

    <!-- Package name of the edge cutout overlay -->
    <java-symbol type="string" name="config_edge_cutout_overlay_package" />

    <!-- Boost Framework -->
    <java-symbol type="bool" name="config_supportsBoostFramework" />

    <!-- PropImitationHooks -->
    <java-symbol type="array" name="config_certifiedBuildProperties" />
    <java-symbol type="string" name="config_stockFingerprint" />
    <java-symbol type="string" name="config_netflixSpoofModel" />

    <!-- KeyboxImitationHooks -->
    <java-symbol type="array" name="config_certifiedKeybox" />

    <!-- Bootleg unneccesary gradient declaration | Just for our shishu bars -->
    <java-symbol type="color" name="bootleg_accent_gradient_end_color" />

    <!-- Pocket Lock -->
    <java-symbol type="layout" name="pocket_lock_view" />
    <!-- Pocket bridge -->
    <java-symbol type="string" name="config_pocketBridgeSysfsInpocket" />
    <java-symbol type="bool" name="config_pocketModeSupported" />
    <java-symbol type="bool" name="config_pocketUseLightSensor" />
    <!-- Pocket Service -->
    <java-symbol type="string" name="config_pocketJudgeVendorSensorName" />
    <java-symbol type="dimen" name="config_pocketJudgeVendorSensorValue" />
    <java-symbol type="string" name="config_pocketJudgeVendorProximitySensorName" />

    <!-- App Lock -->
    <java-symbol type="layout" name="app_lock_credential_activity" />
    <java-symbol type="id" name="app_lock_credential_header" />
    <java-symbol type="id" name="app_lock_credential_error" />
    <java-symbol type="id" name="app_lock_credential_pin_entry" />
    <java-symbol type="id" name="app_lock_credential_pattern_view" />
    <java-symbol type="id" name="app_lock_credential_cancel_button" />
    <java-symbol type="id" name="app_lock_credential_continue_button" />
    <java-symbol type="string" name="app_lock_use_credential_button" />
    <java-symbol type="string" name="app_lock_credential_enter_pin" />
    <java-symbol type="string" name="app_lock_credential_enter_pattern" />
    <java-symbol type="string" name="app_lock_credential_choose_new_pin" />
    <java-symbol type="string" name="app_lock_credential_choose_new_pattern" />
    <java-symbol type="string" name="app_lock_credential_confirm_new_pin" />
    <java-symbol type="string" name="app_lock_credential_confirm_new_pattern" />
    <java-symbol type="string" name="app_lock_credential_wrong" />
    <java-symbol type="string" name="app_lock_credential_mismatch" />
    <java-symbol type="string" name="app_lock_credential_too_short" />
    <java-symbol type="string" name="app_lock_credential_lockout" />
    <java-symbol type="string" name="app_lock_credential_continue" />
    <java-symbol type="string" name="app_lock_credential_set_done" />
    <java-symbol type="string" name="app_lock_credential_cleared" />

    <!-- Delay in ms before invoking single tap gesture
         Should be set to dt2w max time / 2 when needed -->
    <java-symbol type="integer" name="config_singleTapDelay" />

    <!-- Whether device supports sensor based doze customizations -->
    <java-symbol type="bool" name="config_dozePulseTilt" />
    <java-symbol type="bool" name="config_dozePulseProximity" />
    <java-symbol type="bool" name="config_deviceHaveWakeUpProximity" />

    <!-- Whether additional doze settings are available -->
    <java-symbol type="bool" name="config_doze_additional_settings_available" />

    <!-- Whether device has dash charging support -->
    <java-symbol type="bool" name="config_hasDashCharger" />

    <!-- Whether device has warp charging support -->
    <java-symbol type="bool" name="config_hasWarpCharger" />

    <!-- Whether device has VOOC charging support -->
    <java-symbol type="bool" name="config_hasVoocCharger" />
    <java-symbol type="bool" name="config_hasSuperVoocCharger" />

    <!-- Whether device has turbo power charging support -->
    <java-symbol type="bool" name="config_hasTurboPowerCharger" />

    <!-- Path to fast charging status file to detect whether an oem fast charger is active -->
    <java-symbol type="string" name="config_oemFastChargerStatusPath" />

    <!-- Path to fast charging status file to detect whether an oem fast charger is active -->
    <java-symbol type="string" name="config_oemFastChargerStatusPath2" />

    <!-- Expected value from fast charging status file -->
    <java-symbol type="string" name="config_oemFastChargerStatusValue" />
</resources>
