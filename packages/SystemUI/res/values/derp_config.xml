<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Whether to enable burn-in protection for statusbar and navbar -->
    <bool name="config_systemBarBurnInProtection">@*android:bool/config_enableBurnInProtection</bool>
    <!-- Interval between subsequent shifting of statusbar and navbar contents, in seconds -->
    <integer name="config_systemBarBurnInProtectionShiftInterval">60</integer>

    <!-- The CPU temperature sensor path, defaults to empty -->
    <string name="config_cpuTempSensor" translatable="false">/sys/class/thermal/thermal_zone0/temp</string>

    <!-- The CPU temperature divider, if needed -->
    <integer name="config_cpuTempDivider" translatable="false">1</integer>

    <!-- The CPUs to display in CPUInfoService view -->
    <string name="config_displayCpus" translatable="false"></string>

    <!-- Whether battery text contrast inside icon calculation should be expensive -->
    <bool name="config_useHighEndBatteryContrast">true</bool>

    <!-- Charging info current divider, if needed -->
    <integer name="config_currentInfoDivider" translatable="false">1000</integer>

    <!-- Whether device has a dual-cell battery architecture -->
    <bool name="config_hasDualCellBattery">false</bool>

    <!-- Whether OEM fast charge voltage and wattage should be doubled in software
         (e.g., on legacy kernels where the battery fuel gauge only reports single-cell voltage) -->
    <bool name="config_shouldDoubleFastChargeVoltage">false</bool>
</resources>
